## Public storefront + Firebase browser SDK
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

## Comma-separated admin emails Firebase Auth must recognise
NEXT_PUBLIC_ADMIN_EMAILS=you@brand.com,cofounder@brand.com

## WhatsApp business number digits only — no '+' or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

## Optional Razorpay publishable key (secret stays server-side only)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

## Ghost guest emails when checkout omits email (optional)
NEXT_PUBLIC_GUEST_MAIL_DOMAIN=aayunify.local
