rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /* Public SKU browsing */
    match /products/{productId} {
      allow read: if true;
      // For production: tighten to admin custom claims · never leave wide open authenticated writes unattended.
      allow write: if request.auth != null;
    }

    /* Orders */
    match /orders/{orderId} {
      // Production: throttle via Firebase App Check + schema validation callable.
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}


